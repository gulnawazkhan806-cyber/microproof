{
  "expo": {
    "name": "MicroProof",
    "slug": "microproof",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "microproof",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.microproof.ledger",
      "infoPlist": {
        "NSCameraUsageDescription": "MicroProof reads agreement QR codes with the camera."
      }
    },
    "android": {
      "package": "app.microproof.ledger",
      "adaptiveIcon": {
        "backgroundColor": "#f3efe6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "MicroProof reads agreement QR codes with the camera.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
